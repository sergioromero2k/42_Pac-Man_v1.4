        </mxCell>
        <mxCell id="vPt80AYwSmRU7x1GW-21-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Frame&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Es una foto individual de las muchas que se dibujan por segundio para dar la sensación de movimiento, como los fotogramas de una película. Vuestro juego no &quot;se mueve&quot; de verdad, dibuja imágenes fijas muy rápido (normalmente 60 veces por segundo).&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="220" x="-230" y="1519" as="geometry" />
        </mxCell>
        <mxCell id="vPt80AYwSmRU7x1GW-21-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;b&gt;HUD (vidas, score, tiempo, nivel)&lt;/b&gt;&lt;/div&gt;" vertex="1">

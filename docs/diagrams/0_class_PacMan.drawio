        <mxCell id="x02PCa_xB7c4ORvj1PGW-65" parent="1" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;GameView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;Captura teclado (incl. atajos de cheat: invencibilidad, vida extra, saltar nivel, congelar fantasmas) y delega en GameEngine/CheatManager/Player según corresponda.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;Es del módulo &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;ui/&lt;/code&gt;&lt;/p&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">

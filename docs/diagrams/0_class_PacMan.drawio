        <mxCell id="vPt80AYwSmRU7x1GW-21-35" connectable="0" parent="vPt80AYwSmRU7x1GW-21-34" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="usa para dibujar" vertex="1">

        <mxCell id="x02PCa_xB7c4ORvj1PGW-67" connectable="0" parent="x02PCa_xB7c4ORvj1PGW-66" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="compuesto" vertex="1">
